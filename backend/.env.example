# Copy to backend/.env and fill in. Never commit the real file (see .gitignore).
# Names only; every value below is a placeholder.

# --- Database ---
MONGO_URL=
MONGO_DB_NAME=

# --- Auth / sessions ---
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=
VOTER_JWT_EXPIRE_MINUTES=
SUPERADMIN_JWT_EXPIRE_MINUTES=
SUPER_ADMIN_ID=
SUPER_ADMIN_PASSWORD=
SUPERADMIN_TOTP_SECRET=
TEMP_PASSWORD_EXPIRE_HOURS=

# --- CORS / proxy ---
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=
TRUSTED_PROXY_HOPS=
FRONTEND_URL=
REQUIRE_ORG_CONTEXT=

# --- SMS / email ---
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
MAMBOSMS_API_KEY=
MAMBOSMS_SENDER_ID=
MAMBOSMS_MESSAGE_CATEGORY=
ESMS_SENDER_ID=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
BACKUP_ALERT_EMAIL=

# --- Captcha ---
TURNSTILE_MODE=
TURNSTILE_SECRET=

# --- Storage (Cloudinary / Backblaze B2) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BACKUP_ENDPOINT=
B2_BACKUP_KEY_ID=
B2_BACKUP_APPLICATION_KEY=
B2_BACKUP_BUCKET_NAME=
BACKUP_TRIGGER_TOKEN=

# --- Behaviour switches ---
DEBUG_MODE=
DOCS_ENABLED=
DOCS_USERNAME=
DOCS_PASSWORD=
PUBLIC_RESULTS_MODE=
OTP_LIMITER_MODE=
OTP_SEND_LADDER_SECONDS=
ELECTION_DEFAULT_TIMEZONE=
DEFAULT_APPROVAL_POLICY=
ORG_CACHE_TTL_S=
VOTER_EXPORT_MAX_ROWS=
VIEW_AS_MINUTES=
STATUS_LINK_TTL_DAYS=
SUPERADMIN_LOCKOUT_SECONDS_CAP=
ANALYTICS_ENABLED=
ANALYTICS_ALERTS_ENABLED=
ANALYTICS_MAX_RPS=
ANALYTICS_STORE=mongo             # mongo | postgres; Mongo is the default/rollback path
ANALYTICS_POSTGRES_URL=           # Neon pooled connection URL; secret, never commit
ANALYTICS_POSTGRES_POOLED=false   # true for a Neon hostname containing -pooler
ANALYTICS_MAX_BUFFER_KEYS=20000   # bounded analytics buffer if storage is unavailable
ANALYTICS_FLUSH_S=30              # set 600-900 for Neon; alert evaluation still ticks every 30 s

# --- Performance tab (docs/PERFORMANCE_TAB_GUIDE.md). All optional; defaults shown. ---
# PERF_ENABLED=true            # false removes every hook on next start
# MONGO_TIER=free              # preset name; also editable in the tab's Settings card
# DB_OPS_CAP=                  # ops/s cap override (0 or none = no hard cap)
# DB_CONN_CAP=                 # connection cap override
# PERF_WARN_PCT=70
# PERF_CRIT_PCT=90
# PERF_SLOW_COMMAND_MS=250
# PERF_PERSIST_SECONDS=300     # 0 = memory only
# PERF_SINK=mongo              # mongo | postgres (recommended) | mongo_separate | b2 | none
# PERF_POSTGRES_URL=           # secret; separate metrics-only database, TLS required (?sslmode=require)
# PERF_POSTGRES_POOLED=false   # true for PgBouncer/Neon/Supabase pooler URLs
# PERF_MONGO_URL=              # secret; only for PERF_SINK=mongo_separate
# PERF_MONGO_DB=ballotbox_perf
# PERF_RETENTION_DAYS=14
