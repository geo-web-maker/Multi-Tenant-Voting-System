# Copy to frontend/.env (or set in the Vercel project). Never commit the real file.
VITE_API_URL=http://127.0.0.1:8000
# Same-origin proxy (fixes ad blockers / CORS dropping the boot probe): on Vercel set VITE_API_URL=/api (vercel.json
# rewrites /api/* to the backend) and VITE_API_DIRECT_URL to the backend itself for uploads, roster import and export.
# Leave VITE_API_DIRECT_URL empty for local dev. Build-time: redeploy after changing.
VITE_API_DIRECT_URL=
# Per-organisation deployment slug, sent as X-Org-Slug. Leave empty for legacy/default behaviour.
VITE_ORG_SLUG=
VITE_ELECTION_NAME=
VITE_LOGO_URL=
VITE_TURNSTILE_SITE_KEY=
# UI template. Leave empty for the standard UI; "blueprint" for the Blueprint Console look. Build-time: redeploy after changing.
VITE_UI_TEMPLATE=
