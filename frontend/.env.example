# Copy to frontend/.env (or set in the Vercel project). Never commit the real file.
VITE_API_URL=http://127.0.0.1:8000
# Per-organisation deployment slug, sent as X-Org-Slug. Leave empty for legacy/default behaviour.
VITE_ORG_SLUG=
VITE_ELECTION_NAME=
VITE_LOGO_URL=
VITE_TURNSTILE_SITE_KEY=
# UI template. Leave empty for the standard UI; "blueprint" for the Blueprint Console look. Build-time: redeploy after changing.
VITE_UI_TEMPLATE=
