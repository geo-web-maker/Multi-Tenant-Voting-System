# backend/.env — LOCAL TESTING ONLY, never use these values in production
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=electiondbaccounting
JWT_SECRET_KEY=cc894a09051fbbd16e26368c05c625d007b0ffe164f8390d722b8528729e2d83
SUPER_ADMIN_ID=localadmin
SUPER_ADMIN_PASSWORD=LocalTest123!

# Mocks EgoSMS locally — every "SMS" is just logged to console instead of
# sent for real. NEVER set this on Render.
DEBUG_MODE=true

# Leave unset locally — skips superadmin MFA requirement
# SUPERADMIN_TOTP_SECRET=

# Only needed if the load test exercises image upload; leave blank otherwise
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave disabled unless you want Swagger docs during testing
DOCS_ENABLED=false
DOCS_USERNAME=
DOCS_PASSWORD=

# Backblaze B2 — external Object Lock (compliance mode) anchor for audit
# checkpoints. The bucket MUST have Object Lock enabled at creation time
# (cannot be turned on afterward) or every checkpoint anchor will fail.
# Leave blank locally: checkpoints still work against Mongo, but a missed
# anchor silently logs "audit_checkpoint_anchor_failed" instead of raising.
# Get these from the Backblaze web console:
#   B2_ENDPOINT           -> bucket's detail page, "Endpoint" field
#   B2_BUCKET_NAME        -> the bucket name you created (Object Lock: On)
#   B2_KEY_ID/B2_APPLICATION_KEY -> App Keys > Add a New Application Key,
#                            scoped to this bucket only, writeFiles capability
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=